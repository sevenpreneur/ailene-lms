generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StatusEnum {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("status_enum")
}

enum AilRole {
  STUDENT  @map("student")
  CHAMPION @map("champion")
  SPONSOR  @map("sponsor")

  @@map("ail_role")
}

enum AilUseCaseFrequency {
  DAILY        @map("daily")
  WEEKLY       @map("weekly")
  MONTHLY      @map("monthly")
  OCCASIONALLY @map("occasionally")

  @@map("ail_use_case_frequency")
}

enum AilUseCaseType {
  WORKFLOW_AUTOMATION @map("workflow_automation")
  CONTENT_CREATION    @map("content_creation")
  DATA_ANALYSIS       @map("data_analysis")
  RESEARCH            @map("research")
  COMMUNICATION       @map("communication")
  DECISION_SUPPORT    @map("decision_support")
  LEARNING            @map("learning")
  OTHER               @map("other")

  @@map("ail_use_case_type")
}

enum AilLearningType {
  QUIZ     @map("quiz")
  VIDEO    @map("video")
  MATERIAL @map("material")

  @@map("ail_learning_type")
}

enum AilPaAiUseFreq {
  NEVER     @map("never")
  TRIED     @map("tried")
  WEEKLY    @map("weekly")
  DAILY     @map("daily")
  INTENSIVE @map("intensive")

  @@map("ail_pa_ai_use_freq")
}

enum AilPaUnderstanding {
  NONE    @map("none")
  AWARE   @map("aware")
  BASIC   @map("basic")
  EXPLAIN @map("explain")
  EXPERT  @map("expert")

  @@map("ail_pa_understanding")
}

enum AilPaOutputReview {
  NO_CHECK    @map("no_check")
  SOMETIMES   @map("sometimes")
  ALWAYS      @map("always")
  CROSS_CHECK @map("cross_check")
  NO_USE      @map("no_use")

  @@map("ail_pa_output_review")
}

enum AilPaTeamAdoption {
  NONE       @map("none")
  PERSONAL   @map("personal")
  PILOT      @map("pilot")
  POLICY     @map("policy")
  INTEGRATED @map("integrated")

  @@map("ail_pa_team_adoption")
}

enum AilPaPromptSkill {
  NONE       @map("none")
  BASIC      @map("basic")
  DECENT     @map("decent")
  STRUCTURED @map("structured")
  EXPERT     @map("expert")

  @@map("ail_pa_prompt_skill")
}

enum AilPaAttitude {
  TOO_RISKY  @map("too_risky")
  CAUTIOUS   @map("cautious")
  NEUTRAL    @map("neutral")
  SUPPORTIVE @map("supportive")
  ESSENTIAL  @map("essential")

  @@map("ail_pa_attitude")
}

enum AilPaMotivation {
  MANDATORY @map("mandatory")
  CURIOUS   @map("curious")
  TENTATIVE @map("tentative")
  READY     @map("ready")
  EAGER     @map("eager")

  @@map("ail_pa_motivation")
}

model Role {
  id         Int      @id @default(autoincrement()) @db.SmallInt
  name       String   @unique @db.VarChar()
  permission Int      @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz()
  users      User[]

  @@map("roles")
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  full_name        String     @db.VarChar()
  email            String     @unique @db.VarChar()
  phone_country_id Int?       @db.SmallInt
  phone_number     String?    @db.VarChar()
  avatar           String?    @db.VarChar()
  role             Role       @relation(fields: [role_id], references: [id])
  role_id          Int        @default(3) @db.SmallInt
  status           StatusEnum @default(ACTIVE)
  created_at       DateTime   @default(now()) @db.Timestamptz()
  updated_at       DateTime   @default(now()) @updatedAt @db.Timestamptz()
  last_login       DateTime   @default(now()) @updatedAt @db.Timestamptz()
  deleted_at       DateTime?  @db.Timestamptz()
  tokens           Token[]
  ail_member       AilMember?

  @@map("users")
}

model Token {
  id         Int      @id @default(autoincrement()) @db.Integer
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String   @db.Uuid
  is_active  Boolean  @default(false) @db.Boolean
  token      String   @unique @db.Text
  created_at DateTime @default(now()) @db.Timestamptz()

  @@map("tokens")
}

model AileneAnnouncement {
  id         Int        @id @default(1) @db.SmallInt
  title      String     @db.VarChar()
  callout    String     @db.VarChar()
  status     StatusEnum @default(ACTIVE)
  start_date DateTime?  @db.Timestamptz()
  end_date   DateTime?  @db.Timestamptz()
  updated_at DateTime   @default(now()) @updatedAt @db.Timestamptz()

  @@map("ail_announcement")
}

model AilCategory {
  id        Int                  @id @default(autoincrement()) @db.SmallInt
  name      String               @unique @db.VarChar()
  prompts   AilPromptCategory[]
  use_cases AilUseCaseCategory[]

  @@map("ail_categories")
}

model AilMember {
  id               Int       @id @default(autoincrement()) @db.Integer
  user             User      @relation(fields: [user_id], references: [id])
  user_id          String    @unique @db.Uuid
  role             AilRole
  job_title        String    @db.VarChar()
  group            AilGroup? @relation("group_members", fields: [group_id], references: [id])
  group_id         Int?      @db.Integer
  current_level    AilLevel  @relation("member_current_level", fields: [current_level_id], references: [id])
  current_level_id Int       @default(0) @db.Integer
  level_history    Json      @default("[]") @db.Json
  last_active_at   DateTime? @db.Timestamptz()
  created_at       DateTime  @default(now()) @db.Timestamptz()

  championed_groups          AilGroup[]              @relation("group_champion")
  quiz_submissions           AilQuizSubmission[]
  video_completions          AilVideoCompletion[]
  material_completions       AilMaterialCompletion[]
  xp_earnings                AilXpEarning[]
  pre_assessment             AilPreAssessment?
  prompt_submissions         AilPromptSubmission[]   @relation("prompt_submission_member")
  prompt_assignments_given   AilPromptSubmission[]   @relation("prompt_submission_assigned_by")
  prompt_reviews_given       AilPromptSubmission[]   @relation("prompt_submission_reviewed_by")
  use_case_submissions       AilUseCaseSubmission[]  @relation("use_case_submission_member")
  use_case_assignments_given AilUseCaseSubmission[]  @relation("use_case_submission_assigned_by")
  use_case_reviews_given     AilUseCaseSubmission[]  @relation("use_case_submission_reviewed_by")
  coaching_notes_received    AilCoachingNote[]       @relation("coaching_note_member")
  coaching_notes_given       AilCoachingNote[]       @relation("coaching_note_champion")

  @@map("ail_members")
}

model AilCoachingNote {
  id          Int       @id @default(autoincrement()) @db.Integer
  member      AilMember @relation("coaching_note_member", fields: [member_id], references: [id])
  member_id   Int       @db.Integer
  champion    AilMember @relation("coaching_note_champion", fields: [champion_id], references: [id])
  champion_id Int       @db.Integer
  text        String    @db.Text
  created_at  DateTime  @default(now()) @db.Timestamptz()

  @@index([member_id])
  @@map("ail_coaching_notes")
}

model AilGroup {
  id          Int         @id @default(autoincrement()) @db.Integer
  name        String      @db.VarChar()
  champion    AilMember   @relation("group_champion", fields: [champion_id], references: [id])
  champion_id Int         @db.Integer
  created_at  DateTime    @default(now()) @db.Timestamptz()
  updated_at  DateTime    @default(now()) @updatedAt @db.Timestamptz()
  members     AilMember[] @relation("group_members")

  @@map("ail_groups")
}

model AilLevel {
  id              Int          @id @default(autoincrement()) @db.Integer
  level_number    Int          @unique @db.SmallInt
  name            String       @db.VarChar()
  icon            String?      @db.VarChar()
  min_xp          Int          @default(0) @db.Integer
  status          StatusEnum   @default(ACTIVE)
  created_at      DateTime     @default(now()) @db.Timestamptz()
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz()
  chapters        AilChapter[]
  current_members AilMember[]  @relation("member_current_level")
  prompts         AilPrompt[]
  use_cases       AilUseCase[]

  @@map("ail_levels")
}

model AilChapter {
  id           Int           @id @default(autoincrement()) @db.Integer
  level        AilLevel      @relation(fields: [level_id], references: [id])
  level_id     Int           @db.Integer
  name         String        @db.VarChar()
  description  String?       @db.Text
  session_date DateTime      @db.Timestamptz()
  status       StatusEnum    @default(ACTIVE)
  created_at   DateTime      @default(now()) @db.Timestamptz()
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz()
  quizzes      AilQuiz[]
  videos       AilVideo[]
  materials    AilMaterial[]

  @@map("ail_chapters")
}

model AilQuiz {
  id          String              @id @default(nanoid()) @db.VarChar()
  chapter     AilChapter          @relation(fields: [chapter_id], references: [id])
  chapter_id  Int                 @db.Integer
  name        String              @db.VarChar()
  description String?             @db.Text
  order_index Int                 @default(0) @db.SmallInt
  status      StatusEnum          @default(ACTIVE)
  created_at  DateTime            @default(now()) @db.Timestamptz()
  updated_at  DateTime            @default(now()) @updatedAt @db.Timestamptz()
  questions   AilQuizQuestion[]
  submissions AilQuizSubmission[]

  @@map("ail_quizzes")
}

model AilQuizQuestion {
  id          Int             @id @default(autoincrement()) @db.Integer
  quiz        AilQuiz         @relation(fields: [quiz_id], references: [id])
  quiz_id     String          @db.VarChar()
  question    String          @db.Text
  explanation String?         @db.Text
  order_index Int             @default(0) @db.SmallInt
  xp_reward   Int             @default(0) @db.SmallInt
  created_at  DateTime        @default(now()) @db.Timestamptz()
  updated_at  DateTime        @default(now()) @updatedAt @db.Timestamptz()
  options     AilQuizOption[]

  @@map("ail_quiz_questions")
}

model AilQuizOption {
  id          Int             @id @default(autoincrement()) @db.Integer
  question    AilQuizQuestion @relation(fields: [question_id], references: [id])
  question_id Int             @db.Integer
  option_code String          @db.VarChar()
  text        String          @db.VarChar()
  is_correct  Boolean         @default(false) @db.Boolean

  @@map("ail_quiz_options")
}

model AilVideo {
  id          Int                  @id @default(autoincrement()) @db.Integer
  chapter     AilChapter           @relation(fields: [chapter_id], references: [id])
  chapter_id  Int                  @db.Integer
  title       String               @db.VarChar()
  description String?              @db.Text
  video_url   String               @db.Text
  xp_reward   Int                  @default(0) @db.SmallInt
  order_index Int                  @default(0) @db.SmallInt
  status      StatusEnum           @default(ACTIVE)
  created_at  DateTime             @default(now()) @db.Timestamptz()
  updated_at  DateTime             @default(now()) @updatedAt @db.Timestamptz()
  completions AilVideoCompletion[]

  @@map("ail_videos")
}

model AilMaterial {
  id          String                  @id @default(nanoid()) @db.VarChar()
  chapter     AilChapter              @relation(fields: [chapter_id], references: [id])
  chapter_id  Int                     @db.Integer
  title       String                  @db.VarChar()
  description String?                 @db.Text
  content     String?                 @db.Text
  file_url    String?                 @db.Text
  xp_reward   Int                     @default(0) @db.SmallInt
  order_index Int                     @default(0) @db.SmallInt
  status      StatusEnum              @default(ACTIVE)
  created_at  DateTime                @default(now()) @db.Timestamptz()
  updated_at  DateTime                @default(now()) @updatedAt @db.Timestamptz()
  completions AilMaterialCompletion[]

  @@map("ail_materials")
}

model AilPrompt {
  id              Int                   @id @default(autoincrement()) @db.Integer
  level           AilLevel              @relation(fields: [level_id], references: [id])
  level_id        Int                   @db.Integer
  name            String                @db.VarChar()
  scenario        String                @db.Text
  expected_output String                @db.Text
  status          StatusEnum            @default(ACTIVE)
  is_self_created Boolean               @default(false) @db.Boolean
  created_at      DateTime              @default(now()) @db.Timestamptz()
  updated_at      DateTime              @default(now()) @updatedAt @db.Timestamptz()
  categories      AilPromptCategory[]
  submissions     AilPromptSubmission[]

  @@map("ail_prompts")
}

model AilUseCase {
  id              Int                    @id @default(autoincrement()) @db.Integer
  level           AilLevel               @relation(fields: [level_id], references: [id])
  level_id        Int                    @db.Integer
  name            String                 @db.VarChar()
  description     String                 @db.Text
  status          StatusEnum             @default(ACTIVE)
  is_self_created Boolean                @default(false) @db.Boolean
  created_at      DateTime               @default(now()) @db.Timestamptz()
  updated_at      DateTime               @default(now()) @updatedAt @db.Timestamptz()
  categories      AilUseCaseCategory[]
  submissions     AilUseCaseSubmission[]

  @@map("ail_use_cases")
}

model ErrorLog {
  id         Int      @id @default(autoincrement()) @db.Integer
  context    String   @db.VarChar()
  message    Json     @db.Json
  created_at DateTime @default(now()) @db.Timestamptz()

  @@map("error_logs")
}

model AilPromptCategory {
  prompt      AilPrompt   @relation(fields: [prompt_id], references: [id])
  prompt_id   Int         @db.Integer
  category    AilCategory @relation(fields: [category_id], references: [id])
  category_id Int         @db.SmallInt

  @@id([prompt_id, category_id])
  @@map("ail_prompt_categories")
}

model AilUseCaseCategory {
  use_case    AilUseCase  @relation(fields: [use_case_id], references: [id])
  use_case_id Int         @db.Integer
  category    AilCategory @relation(fields: [category_id], references: [id])
  category_id Int         @db.SmallInt

  @@id([use_case_id, category_id])
  @@map("ail_use_case_categories")
}

model AilQuizSubmission {
  id             Int       @id @default(autoincrement()) @db.Integer
  member         AilMember @relation(fields: [member_id], references: [id])
  member_id      Int       @db.Integer
  quiz           AilQuiz   @relation(fields: [quiz_id], references: [id])
  quiz_id        String    @db.VarChar()
  attempt_number Int       @db.SmallInt
  answers        Json      @db.Json
  score          Int       @db.SmallInt
  is_completed   Boolean   @default(false) @db.Boolean
  started_at     DateTime  @default(now()) @db.Timestamptz()
  submitted_at   DateTime  @default(now()) @db.Timestamptz()

  @@unique([member_id, quiz_id, attempt_number])
  @@map("ail_quiz_submissions")
}

model AilVideoCompletion {
  member       AilMember @relation(fields: [member_id], references: [id])
  member_id    Int       @db.Integer
  video        AilVideo  @relation(fields: [video_id], references: [id])
  video_id     Int       @db.Integer
  completed_at DateTime  @default(now()) @db.Timestamptz()

  @@id([member_id, video_id])
  @@map("ail_video_completions")
}

model AilMaterialCompletion {
  member       AilMember   @relation(fields: [member_id], references: [id])
  member_id    Int         @db.Integer
  material     AilMaterial @relation(fields: [material_id], references: [id])
  material_id  String      @db.VarChar()
  completed_at DateTime    @default(now()) @db.Timestamptz()

  @@id([member_id, material_id])
  @@map("ail_material_completions")
}

model AilXpEarning {
  id            Int             @id @default(autoincrement()) @db.Integer
  member        AilMember       @relation(fields: [member_id], references: [id])
  member_id     Int             @db.Integer
  learning_type AilLearningType
  learning_id   String          @db.VarChar()
  xp_earned     Int             @db.SmallInt
  earned_at     DateTime        @default(now()) @db.Timestamptz()

  @@unique([member_id, learning_type, learning_id])
  @@map("ail_xp_earnings")
}

model AilPreAssessment {
  id                        Int                @id @default(autoincrement()) @db.Integer
  member                    AilMember          @relation(fields: [member_id], references: [id])
  member_id                 Int                @unique @db.Integer
  q1_ai_use_frequency       AilPaAiUseFreq
  q2_ai_tools_used          String[]           @db.Text
  q3_job_role               String             @db.VarChar()
  q4_ai_understanding       AilPaUnderstanding
  q5_ai_limitations         String[]           @db.Text
  q6_output_review          AilPaOutputReview
  q7_use_cases              String[]           @db.Text
  q8_team_adoption          AilPaTeamAdoption
  q9_concrete_example       String?            @db.VarChar()
  q10_prompt_comfort        AilPaPromptSkill
  q11_safety_practices      String[]           @db.Text
  q12_professional_attitude AilPaAttitude
  q13_biggest_challenge     String             @db.Text
  q14_training_expectation  String             @db.Text
  q15_motivation            AilPaMotivation
  created_at                DateTime           @default(now()) @db.Timestamptz()

  @@map("ail_pre_assessments")
}

model AilPromptSubmission {
  id                 Int        @id @default(autoincrement()) @db.Integer
  member             AilMember  @relation("prompt_submission_member", fields: [member_id], references: [id])
  member_id          Int        @db.Integer
  prompt             AilPrompt  @relation(fields: [prompt_id], references: [id])
  prompt_id          Int        @db.Integer
  assigned_by        AilMember? @relation("prompt_submission_assigned_by", fields: [assigned_by_id], references: [id])
  assigned_by_id     Int?       @db.Integer
  deadline           DateTime?  @db.Timestamptz()
  message            String?    @db.Text
  input              String?    @db.Text
  output             String?    @db.Text
  submitted_at       DateTime?  @db.Timestamptz()
  reviewed_by        AilMember? @relation("prompt_submission_reviewed_by", fields: [reviewed_by_id], references: [id])
  reviewed_by_id     Int?       @db.Integer
  reviewed_at        DateTime?  @db.Timestamptz()
  comment            String?    @db.Text
  is_accepted        Boolean    @default(false) @db.Boolean
  rubric_specificity Int?       @db.SmallInt
  rubric_context     Int?       @db.SmallInt
  rubric_constraints Int?       @db.SmallInt
  rubric_examples    Int?       @db.SmallInt
  rubric_iteration   Int?       @db.SmallInt
  created_at         DateTime   @default(now()) @db.Timestamptz()
  updated_at         DateTime   @default(now()) @updatedAt @db.Timestamptz()

  @@unique([member_id, prompt_id])
  @@map("ail_prompt_submissions")
}

model AilUseCaseSubmission {
  id               Int                  @id @default(autoincrement()) @db.Integer
  member           AilMember            @relation("use_case_submission_member", fields: [member_id], references: [id])
  member_id        Int                  @db.Integer
  use_case         AilUseCase           @relation(fields: [use_case_id], references: [id])
  use_case_id      Int                  @db.Integer
  assigned_by      AilMember?           @relation("use_case_submission_assigned_by", fields: [assigned_by_id], references: [id])
  assigned_by_id   Int?                 @db.Integer
  deadline         DateTime?            @db.Timestamptz()
  message          String?              @db.Text
  outcome_proof    String?              @db.VarChar()
  hours_with_ai    Decimal?             @db.Decimal(6, 2)
  hours_without_ai Decimal?             @db.Decimal(6, 2)
  description      String?              @db.Text
  ai_tool          String?              @db.VarChar()
  frequency        AilUseCaseFrequency?
  type             AilUseCaseType?
  submitted_at     DateTime?            @db.Timestamptz()
  reviewed_by      AilMember?           @relation("use_case_submission_reviewed_by", fields: [reviewed_by_id], references: [id])
  reviewed_by_id   Int?                 @db.Integer
  reviewed_at      DateTime?            @db.Timestamptz()
  comment          String?              @db.Text
  is_accepted      Boolean              @default(false) @db.Boolean
  created_at       DateTime             @default(now()) @db.Timestamptz()
  updated_at       DateTime             @default(now()) @updatedAt @db.Timestamptz()

  @@unique([member_id, use_case_id])
  @@map("ail_use_case_submissions")
}
